{{!-- INVENTÁRIO: Yan purse, the items by kind, consumables with charge boxes, total weight. --}}
<section class="tab ij-tab ij-inventario {{tab.cssClass}}" data-tab="inventario" data-group="primary">
  <div class="ij-sheet-title">
    <span class="ij-sheet-title__kanji">袋</span>
    <h2>{{localize "IJ.Tab.inventario"}}</h2>
    <span class="ij-sheet-title__note">{{localize "IJ.Inventory.weight"}}: <strong>{{weight}} kg</strong></span>
  </div>

  <div class="ij-purse">
    {{#each currencies as |c|}}
    <label class="ij-coin-field">
      <span class="ij-coin ij-coin--{{c.key}}" aria-hidden="true"></span>
      <span class="ij-coin-field__label">{{c.label}}</span>
      <input class="ij-select-on-focus" type="text" inputmode="numeric" name="system.currency.{{c.key}}" value="{{c.value}}" data-tooltip="{{localize 'IJ.Sheet.deltaHint'}}">
      <span class="ij-coin-field__abbr">{{c.abbr}}</span>
    </label>
    {{/each}}
    <span class="ij-purse__note">{{localize "IJ.Currency.note"}}</span>
  </div>

  <div class="ij-box ij-inventory">
    <header class="ij-box__head ij-box__head--big"><span>{{localize "IJ.Inventory.label"}}</span></header>
    {{#each inventory as |group|}}
    <div class="ij-inv-group">
      <div class="ij-inv-group__head">
        <span>{{group.label}}</span>
        {{#if @root.editable}}<a class="ij-ctl" data-action="itemCreate" data-type="{{group.type}}" data-tooltip="{{localize 'IJ.Item.create'}}"><i class="fa-solid fa-plus"></i></a>{{/if}}
      </div>
      <ol class="ij-inv-list">
        {{#each group.items as |i|}}
        <li class="ij-inv-row ij-item-row draggable" data-item-id="{{i.id}}">
          <img class="ij-inv-row__img" src="{{i.img}}" alt="">
          <a class="ij-inv-row__name" data-action="itemEdit">{{i.name}}</a>
          {{#if (ne i.equipped null)}}
          <a class="ij-equip ij-equip--sm {{#if i.equipped}}on{{/if}}" data-action="itemEquip" data-tooltip="{{#if i.equipped}}{{localize 'IJ.Item.equipped'}}{{else}}{{localize 'IJ.Item.stowed'}}{{/if}}"><i class="fa-solid fa-check"></i></a>
          {{/if}}
          <span class="ij-qty">
            {{#if @root.editable}}<a data-action="itemQuantity" data-delta="-1"><i class="fa-solid fa-minus"></i></a>{{/if}}
            <span>{{i.quantity}}</span>
            {{#if @root.editable}}<a data-action="itemQuantity" data-delta="1"><i class="fa-solid fa-plus"></i></a>{{/if}}
          </span>
          <span class="ij-inv-row__weight">{{#if i.weight}}{{i.weight}} kg{{/if}}</span>
          <span class="ij-inv-row__price">{{i.price}}</span>
          {{> ij-item-controls}}
        </li>
        {{else}}
        <li class="ij-inv-row ij-inv-row--empty">—</li>
        {{/each}}
      </ol>
    </div>
    {{/each}}

    <div class="ij-inv-group">
      <div class="ij-inv-group__head">
        <span>{{localize "IJ.Inventory.consumables"}}</span>
        {{#if editable}}<a class="ij-ctl" data-action="itemCreate" data-type="consumable" data-tooltip="{{localize 'IJ.Item.create'}}"><i class="fa-solid fa-plus"></i></a>{{/if}}
      </div>
      <ol class="ij-inv-list">
        {{#each consumables as |i|}}
        <li class="ij-inv-row ij-inv-row--consumable ij-item-row draggable" data-item-id="{{i.id}}">
          <img class="ij-inv-row__img" src="{{i.img}}" alt="">
          <a class="ij-inv-row__name" data-action="itemUse" data-tooltip="{{localize 'IJ.Consumable.useTip'}}">{{i.name}}</a>
          <span class="ij-inv-row__kind">{{i.kind}}</span>
          {{#if i.uses}}
          <span class="ij-boxes">
            {{#each i.uses as |u|}}<a class="ij-box-pip {{#if u.full}}on{{/if}}" data-action="usesPip" data-n="{{u.n}}"></a>{{/each}}
          </span>
          {{else}}
          <span class="ij-qty">
            {{#if @root.editable}}<a data-action="itemQuantity" data-delta="-1"><i class="fa-solid fa-minus"></i></a>{{/if}}
            <span>{{i.quantity}}</span>
            {{#if @root.editable}}<a data-action="itemQuantity" data-delta="1"><i class="fa-solid fa-plus"></i></a>{{/if}}
          </span>
          {{/if}}
          <span class="ij-inv-row__price">{{i.price}}</span>
          {{> ij-item-controls}}
        </li>
        {{else}}
        <li class="ij-inv-row ij-inv-row--empty">—</li>
        {{/each}}
      </ol>
    </div>
  </div>
  <p class="ij-hint"><i class="fa-solid fa-arrows-up-down-left-right"></i> {{localize "IJ.Inventory.dropHint"}}</p>
</section>
