{{!-- FICHA: the six abilities, then what is rolled at the table: skills, combat, techniques. --}}
<section class="tab ij-tab ij-ficha {{tab.cssClass}}" data-tab="ficha" data-group="primary">
  {{#if wizard.blank}}{{#if wizard.can}}
  <div class="ij-wizard-banner">
    <span class="ij-wizard-banner__kanji" aria-hidden="true">名</span>
    <div class="ij-wizard-banner__text">
      <strong>{{localize "IJ.Wizard.Banner.title"}}</strong>
      <span>{{localize "IJ.Wizard.Banner.text"}}</span>
    </div>
    <button type="button" class="ij-wizard-banner__button" data-action="openWizard"><i class="fa-solid fa-feather-pointed"></i>{{localize "IJ.Wizard.open"}}</button>
  </div>
  {{/if}}{{/if}}

  <div class="ij-abilities">
    {{#each abilities as |a|}}
    <div class="ij-ability">
      <span class="ij-ability__kanji" aria-hidden="true">{{a.kanji}}</span>
      <span class="ij-ability__label">{{a.label}}{{#if (and @root.editMode a.racial)}} <small data-tooltip="{{localize 'IJ.Ability.racialTip'}}">{{a.racial}}</small>{{/if}}</span>
      <span class="ij-ability__score">
        {{#if @root.editMode}}
        <input type="number" name="system.abilities.{{a.key}}.value" value="{{a.value}}" min="0" step="1">
        <input class="ij-bonus" type="number" name="system.abilities.{{a.key}}.bonus" value="{{a.bonus}}" step="1" data-tooltip="{{localize 'IJ.Ability.bonusTip'}}">
        {{else}}
        {{a.total}}
        {{/if}}
      </span>
      <a class="ij-stone ij-stone--lg {{#if a.negative}}is-neg{{/if}}" data-action="rollAbility" data-ability="{{a.key}}" data-tooltip="{{localize 'IJ.Roll.abilityTip'}}">{{a.mod}}</a>
      {{#if a.damage}}<a class="ij-wound" data-action="healAbility" data-ability="{{a.key}}" data-tooltip="{{localize 'IJ.Ability.damageTip'}}">−{{a.damage}}</a>{{/if}}
    </div>
    {{/each}}
  </div>

  <div class="ij-play">

    {{!-- ============ Skills: the trained ones wear a stone ============ --}}
    <section class="ij-panel ij-panel--skills">
      <header class="ij-head">
        <span class="ij-head__kanji" aria-hidden="true">技</span>
        <h3>{{localize "IJ.Tab.pericias"}}</h3>
        <span class="ij-head__note {{#if skillOver}}is-over{{/if}}" data-tooltip="{{localize 'IJ.Skill.countTip'}}"><strong>{{skillCount.trained}}</strong>{{#if skillCount.allowed}} / {{skillCount.allowed}}{{/if}} {{localize "IJ.Skill.trainedLower"}}</span>
      </header>
      <ul>
        {{#each skills as |s|}}
        <li class="ij-skill {{#if s.trained}}is-trained{{/if}} {{#unless s.usable}}is-locked{{/unless}} {{#if s.isSpecialty}}is-spec{{/if}}">
          {{#if @root.editMode}}
          <a class="ij-pip {{#if s.trained}}on{{/if}}" data-action="toggleTrained" data-skill="{{s.key}}" {{#if s.specialtyId}}data-specialty="{{s.specialtyId}}"{{/if}}
             data-tooltip="{{#if s.trained}}{{localize 'IJ.Skill.trained'}}{{else}}{{localize 'IJ.Skill.untrained'}}{{/if}}"></a>
          {{else}}
          <span class="ij-pip {{#if s.trained}}on{{/if}}"></span>
          {{/if}}

          {{#if (and s.isSpecialty @root.editMode)}}
          <input class="ij-skill__spec" type="text" name="{{s.inputName}}.label" value="{{s.specialty}}" list="ij-spec-{{s.key}}" placeholder="{{localize 'IJ.Skill.specialtyPlaceholder'}}">
          <a class="ij-skill__x" data-action="specialtyDelete" data-specialty="{{s.specialtyId}}" data-tooltip="{{localize 'IJ.Skill.specialtyDelete'}}">✕</a>
          {{else}}
          <a class="ij-skill__name" data-action="rollSkill" data-skill="{{s.key}}" {{#if s.specialtyId}}data-specialty="{{s.specialtyId}}"{{/if}}>{{s.display}}</a>
          {{#if s.trainedOnly}}<span class="ij-skill__flag" data-tooltip="{{localize 'IJ.Skill.trainedOnly'}}">✦</span>{{/if}}
          {{#if s.armor}}<span class="ij-skill__flag ij-skill__flag--armor" data-tooltip="{{localize 'IJ.Skill.armorPenalty'}}">⛉</span>{{/if}}
          {{#if (and s.multi @root.editMode)}}<a class="ij-plus" data-action="specialtyAdd" data-skill="{{s.key}}" data-tooltip="{{localize 'IJ.Skill.specialtyAdd'}}">+</a>{{/if}}
          {{/if}}

          <span class="ij-skill__lead"></span>

          {{#if @root.editMode}}
          {{#if s.isSpecialty}}
          <span class="ij-skill__abl">{{s.abilityAbbr}}</span>
          {{else}}
          <select name="{{s.inputName}}.ability" data-tooltip="{{localize 'IJ.Skill.abilityShort'}}">{{selectOptions @root.choices.abilities selected=s.ability}}</select>
          {{/if}}
          <input class="ij-skill__bonus" type="number" name="{{s.inputName}}.bonus" value="{{s.bonus}}" step="1" data-tooltip="{{localize 'IJ.Skill.other'}}">
          {{else}}
          <span class="ij-skill__abl">{{s.abilityAbbr}}</span>
          {{/if}}

          <a class="ij-skill__total {{#if s.stone}}ij-stone{{/if}}" data-action="rollSkill" data-skill="{{s.key}}" {{#if s.specialtyId}}data-specialty="{{s.specialtyId}}"{{/if}} data-tooltip="{{s.tip}}" data-tooltip-direction="RIGHT">{{#if s.usable}}{{s.total}}{{else}}—{{/if}}</a>
        </li>
        {{/each}}
      </ul>
      {{#each specialties as |list key|}}
      <datalist id="ij-spec-{{key}}">{{#each list as |name|}}<option value="{{name}}"></option>{{/each}}</datalist>
      {{/each}}
      <div class="ij-skills__legend">
        <span><span class="ij-skill__flag">✦</span> {{localize "IJ.Skill.trainedOnly"}}</span>
        <span><span class="ij-skill__flag ij-skill__flag--armor">⛉</span> {{localize "IJ.Skill.armorShort"}}{{#if armorPenalty}} ({{ij-signed armorPenalty}}){{/if}}</span>
      </div>
    </section>

    {{!-- ============ Combat ============ --}}
    <section class="ij-panel ij-panel--combat">
      <header class="ij-head">
        <span class="ij-head__kanji" aria-hidden="true">戦</span>
        <h3>{{localize "IJ.Tab.combate"}}</h3>
        <span class="ij-head__note ij-bba" data-tooltip="{{localize 'IJ.BBA.tooltip'}}">
          {{localize "IJ.BBA.abbr"}}
          {{#if (and editMode (not auto.classes))}}
          <input type="number" name="system.attributes.bba" value="{{source.attributes.bba}}" step="1">
          {{else}}
          <strong>{{bba}}</strong>
          {{/if}}
        </span>
      </header>

      <div class="ij-saves">
        {{#each saves as |s|}}
        <div class="ij-save">
          <a class="ij-stone" data-action="rollSave" data-save="{{s.key}}" data-tooltip="{{localize 'IJ.Save.tip'}}">{{s.total}}</a>
          <a class="ij-save__text" data-action="rollSave" data-save="{{s.key}}"><b>{{s.label}}</b><small>{{s.ability}} {{s.mod}}</small></a>
        </div>
        {{/each}}
      </div>

      <div class="ij-strikes">
        <a class="ij-strike" data-action="rollPlainAttack" data-type="melee" data-tooltip="{{localize 'IJ.Attack.meleeTip'}}"><span class="ij-stone">{{melee}}</span><span>{{localize "IJ.Attack.melee"}}</span></a>
        <a class="ij-strike" data-action="rollPlainAttack" data-type="ranged" data-tooltip="{{localize 'IJ.Attack.rangedTip'}}"><span class="ij-stone">{{ranged}}</span><span>{{localize "IJ.Attack.ranged"}}</span></a>
        <a class="ij-strike" data-action="rollInitiative" data-tooltip="{{localize 'IJ.Skill.initiativeTip'}}"><span class="ij-stone">{{initiative}}</span><span>{{localize "IJ.Skill.iniciativa"}}</span></a>
      </div>
      {{#if editMode}}
      <div class="ij-tweaks">
        {{#each saves as |s|}}<label>{{s.label}} <input type="number" name="system.saves.{{s.key}}.bonus" value="{{s.bonus}}" step="1"></label>{{/each}}
        <label>{{localize "IJ.Attack.meleeBonus"}} <input type="number" name="system.attributes.attack.melee" value="{{source.attributes.attack.melee}}" step="1"></label>
        <label>{{localize "IJ.Attack.rangedBonus"}} <input type="number" name="system.attributes.attack.ranged" value="{{source.attributes.attack.ranged}}" step="1"></label>
        <label>{{localize "IJ.Attack.damageBonus"}} <input type="number" name="system.attributes.attack.damage" value="{{source.attributes.attack.damage}}" step="1"></label>
      </div>
      {{/if}}

      <h4 class="ij-sub">{{localize "IJ.Weapon.inHand"}}</h4>
      <ul>
        {{#each weaponsInHand as |w|}}
        <li class="ij-arm ij-item draggable" data-item-id="{{w.id}}">
          <img class="ij-arm__img" src="{{w.img}}" alt="">
          <a class="ij-arm__name" data-action="itemUse" data-tooltip="{{localize 'IJ.Weapon.attackTip'}} · {{w.kind}}">{{w.name}}{{#unless w.proficient}} <small>{{localize "IJ.Weapon.notProficientShort"}}</small>{{/unless}}</a>
          <a class="ij-stone ij-stone--sm" data-action="itemUse" data-tooltip="{{localize 'IJ.Weapon.attackTip'}}">{{w.attack}}</a>
          <a class="ij-roll" data-action="itemDamage" data-tooltip="{{localize 'IJ.Weapon.rollDamage'}} · {{w.typeLabel}}">{{w.damage}}</a>
          <a class="ij-roll ij-roll--crit" data-action="itemDamage" data-crit="true" data-tooltip="{{localize 'IJ.Weapon.critTip'}}">{{w.crit}}</a>
        </li>
        {{else}}
        <li class="ij-none">{{localize "IJ.Weapon.hintEquip"}}</li>
        {{/each}}
      </ul>

      <h4 class="ij-sub">{{localize "IJ.Defense.label"}}</h4>
      {{#with bodyArmor as |a|}}
      <div class="ij-worn ij-item" data-item-id="{{a.id}}">
        <a class="ij-worn__name" data-action="itemEdit">{{a.name}}</a>
        {{#if @root.editable}}<a class="ij-worn__off" data-action="itemEquip" data-tooltip="{{localize 'IJ.Armor.unequip'}}">✕</a>{{/if}}
        <span class="ij-worn__stats">{{localize "IJ.CA.abbr"}} <b>{{a.bonus}}</b> · {{localize "IJ.Armor.maxDexShort"}} <b>{{a.maxDex}}</b> · {{localize "IJ.Armor.penaltyShort"}} <b>{{a.penalty}}</b>{{#if a.rd}} · {{localize "IJ.RD.abbr"}} <b>{{a.rd}}</b>{{/if}}</span>
      </div>
      {{else}}
      <div class="ij-worn"><span class="ij-none">{{localize "IJ.Armor.none"}}</span></div>
      {{/with}}
      {{#with shield as |a|}}
      <div class="ij-worn ij-item" data-item-id="{{a.id}}">
        <a class="ij-worn__name" data-action="itemEdit">{{a.name}}</a>
        {{#if @root.editable}}<a class="ij-worn__off" data-action="itemEquip" data-tooltip="{{localize 'IJ.Armor.unequip'}}">✕</a>{{/if}}
        <span class="ij-worn__stats">{{localize "IJ.CA.abbr"}} <b>{{a.bonus}}</b> · {{localize "IJ.Armor.penaltyShort"}} <b>{{a.penalty}}</b>{{#if a.rd}} · {{localize "IJ.RD.abbr"}} <b>{{a.rd}}</b>{{/if}}</span>
      </div>
      {{/with}}
      <div class="ij-sum" data-tooltip="{{localize 'IJ.CA.tooltip'}}">
        <span class="ij-cap">{{localize "IJ.CA.abbr"}}</span><b>{{ca}}</b><span>=</span>
        {{#each caParts as |p|}}
        {{#if (and p.field @root.editMode)}}
        <span><input type="number" name="{{p.field}}" value="{{p.value}}" step="1"> {{p.label}}</span>
        {{else if p.show}}
        <span><b>{{p.text}}</b> {{p.label}}</span>
        {{/if}}
        {{/each}}
      </div>
      <div class="ij-sum">
        <span data-tooltip="{{localize 'IJ.RD.tooltip'}}"><span class="ij-cap">{{localize "IJ.RD.abbr"}}</span>
          {{#if editMode}}<input type="number" name="system.attributes.rd" value="{{source.attributes.rd}}" min="0" step="1">{{else}}<b>{{rd}}</b>{{/if}}
        </span>
        <span><span class="ij-cap">{{localize "IJ.Energy.short"}}</span>
          <input class="ij-wide" type="text" name="system.attributes.energy" value="{{source.attributes.energy}}" placeholder="{{localize 'IJ.Energy.placeholder'}}">
        </span>
      </div>

      <div class="ij-moves">
        <span class="ij-cap">{{localize "IJ.Maneuver.plural"}}</span>
        {{#each maneuvers as |m|}}<a data-action="rollManeuver" data-kind="{{m.key}}" data-tooltip="{{m.tip}}">{{m.label}}</a>{{/each}}
      </div>

      {{#if effects.length}}
      <h4 class="ij-sub">{{localize "IJ.Effects.label"}}</h4>
      <ul>
        {{#each effects as |e|}}
        <li class="ij-fx" {{#if e.tip}}data-tooltip="{{e.tip}}"{{/if}}>
          <img class="ij-arm__img" src="{{e.img}}" alt="">
          <span class="ij-fx__name">{{e.name}}</span>
          <span class="ij-fx__time">{{e.time}}</span>
          {{#if @root.editable}}<a class="ij-fx__end" data-action="effectEnd" data-effect="{{e.id}}" data-tooltip="{{localize 'IJ.Effects.end'}}">✕</a>{{/if}}
        </li>
        {{/each}}
      </ul>
      {{/if}}
    </section>

    {{!-- ============ Techniques: what spends PM or has uses, and what is drunk, thrown or read ============ --}}
    <section class="ij-panel ij-panel--arts">
      <header class="ij-head">
        <span class="ij-head__kanji" aria-hidden="true">業</span>
        <h3>{{localize "IJ.Arts.label"}}</h3>
      </header>
      <ul>
        {{#each arts as |p|}}
        <li class="ij-art ij-item {{#if p.off}}is-off{{/if}}" data-item-id="{{p.id}}">
          <a class="ij-orb {{#unless p.cost}}ij-orb--free{{/unless}} {{#if p.off}}is-off{{/if}}" data-action="itemUse" data-tooltip="{{localize 'IJ.Item.useTip'}}">{{#if p.cost}}{{p.cost}}{{else}}◆{{/if}}</a>
          <a class="ij-art__name" data-action="itemUse" data-tooltip="{{p.tip}}">{{p.name}}</a>
          <span class="ij-art__meta">{{#if p.uses}}<b data-tooltip="{{localize 'IJ.Auto.usesTip'}}">{{p.uses}}</b>{{/if}}{{#if p.offLabel}} {{p.offLabel}}{{/if}}</span>
        </li>
        {{else}}
        <li class="ij-none">{{localize "IJ.Arts.empty"}}</li>
        {{/each}}
      </ul>

      {{#if quickJutsus.length}}
      <h4 class="ij-sub"><span>{{localize "IJ.Tab.jutsus"}}</span><a data-action="tab" data-group="primary" data-tab="jutsus" data-tooltip="{{localize 'IJ.Arts.jutsusTip'}}">{{jutsuCount}} ›</a></h4>
      <div class="ij-scrolls ij-scrolls--quick">
        {{#each quickJutsus as |j|}}
        <span class="ij-scroll ij-item {{#if j.off}}is-off{{/if}}" data-item-id="{{j.id}}">
          <a class="ij-orb {{#if j.off}}is-off{{/if}}" data-action="itemUse" data-tooltip="{{localize 'IJ.Jutsu.executeTip'}}">{{j.cost}}</a>
          <a class="ij-scroll__name" data-action="itemUse" data-tooltip="{{j.tip}}">{{j.name}}</a>
        </span>
        {{/each}}
      </div>
      {{/if}}

      {{#if quick.length}}
      <h4 class="ij-sub">{{localize "IJ.Inventory.consumables"}}</h4>
      <ul>
        {{#each quick as |c|}}
        <li class="ij-art ij-item" data-item-id="{{c.id}}">
          <img class="ij-arm__img" src="{{c.img}}" alt="">
          <a class="ij-art__name" data-action="itemUse" data-tooltip="{{localize 'IJ.Consumable.useTip'}}">{{c.name}}</a>
          <span class="ij-art__meta">
            {{#if c.uses}}<span class="ij-boxes">{{#each c.uses as |u|}}<a class="ij-box-pip {{#if u.full}}on{{/if}}" data-action="usesPip" data-n="{{u.n}}"></a>{{/each}}</span>
            {{else}}×{{c.quantity}}{{/if}}
          </span>
        </li>
        {{/each}}
      </ul>
      {{/if}}

      <p class="ij-hint">{{localize "IJ.Arts.hint"}}</p>
    </section>
  </div>
</section>
