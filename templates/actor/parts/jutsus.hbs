{{!--
  JUTSUS: the lotus of the six chakras (an open one is a jade petal; the ring in its heart is the PM left), and the
  jutsus each chakra feeds, grade by grade. The orb of a jutsu executes it; its name unrolls it on the scroll.
--}}
<section class="tab ij-tab ij-tab--split ij-jutsus {{tab.cssClass}}" data-tab="jutsus" data-group="primary">
  <div class="ij-split">
    <div class="ij-pane">
      <div class="ij-ki">

        <div class="ij-ki__side">
          <header class="ij-head">
            <span class="ij-head__kanji" aria-hidden="true">気</span>
            <h3>{{localize "IJ.Chakra.plural"}}</h3>
            <span class="ij-head__note">{{chakraNote}}</span>
          </header>

          {{#with lotus as |l|}}
          <svg class="ij-lotus" viewBox="{{l.viewBox}}" role="img" aria-label="{{localize 'IJ.Chakra.plural'}}">
            <defs>
              <radialGradient id="ij-lotus-jade" cx="50%" cy="100%" r="100%">
                <stop offset="0" stop-color="#1c5540"/><stop offset=".55" stop-color="#3f8f6c"/><stop offset="1" stop-color="#93dcb8"/>
              </radialGradient>
            </defs>
            <g transform="translate({{l.cx}} {{l.cy}})">
              {{#each l.backs as |a|}}<path class="ij-lotus__back" d="{{l.back}}" transform="rotate({{a}})"/>{{/each}}
              {{#each l.petals as |p|}}
              <g {{#if @root.editMode}}data-action="chakraToggle" data-chakra="{{p.key}}"{{/if}} data-tooltip="{{p.tip}}">
                <path class="ij-lotus__petal {{#if p.open}}open{{/if}}" d="{{l.petal}}" transform="rotate({{p.angle}})"/>
              </g>
              {{/each}}
              <circle class="ij-lotus__heart" r="{{l.inner}}"/>
              <circle class="ij-lotus__track" r="{{l.ring.r}}"/>
              <circle class="ij-lotus__ring" r="{{l.ring.r}}" stroke-dasharray="{{l.ring.dash}}" transform="rotate(-90)"/>
              <text class="ij-lotus__ki" y="-19">気</text>
              <text class="ij-lotus__pm" y="9">{{@root.pm.value}}</text>
              <text class="ij-lotus__max" y="24">/ {{@root.pm.max}} {{localize "IJ.PM.abbr"}}</text>
            </g>
            {{#each l.petals as |p|}}
            <text class="ij-lotus__kanji {{#if p.open}}open{{/if}}" x="{{p.kx}}" y="{{p.ky}}">{{p.kanji}}</text>
            <text class="ij-lotus__label {{#if p.open}}open{{/if}}" x="{{p.lx}}" y="{{p.ly}}" text-anchor="{{p.side}}">{{p.label}}</text>
            {{/each}}
          </svg>
          {{/with}}

          {{#if editMode}}
          <ul class="ij-chakra-edit">
            {{#each chakras as |c|}}
            <li>
              <a class="ij-pip {{#if c.open}}on{{/if}}" data-action="chakraToggle" data-chakra="{{c.key}}" data-tooltip="{{#if c.open}}{{localize 'IJ.Chakra.openTip'}}{{else}}{{localize 'IJ.Chakra.closedTip'}}{{/if}}"></a>
              <b>{{c.kanji}}</b><span>{{c.label}}</span>
              {{#if c.open}}<select name="system.chakras.{{c.key}}.grade">{{selectOptions @root.choices.grades selected=c.grade}}</select>{{/if}}
            </li>
            {{/each}}
          </ul>
          {{/if}}

          <div class="ij-limit" data-tooltip="{{localize 'IJ.PM.limitTip'}}">
            <span class="ij-cap">{{localize "IJ.PM.limitLong"}}</span>
            <strong>{{pm.limit}}</strong>
            <span>{{localize "IJ.PM.limitFormula"}}</span>
            {{#if editMode}}<input type="number" name="system.attributes.pm.limitBonus" value="{{source.attributes.pm.limitBonus}}" step="1" data-tooltip="{{localize 'IJ.Skill.other'}}">{{/if}}
          </div>

          <table class="ij-grades">
            <thead><tr><th>{{localize "IJ.Jutsu.grade"}}</th><th>{{localize "IJ.PM.abbr"}}</th><th>{{localize "IJ.Jutsu.dc"}}</th></tr></thead>
            <tbody>
              {{#each grades as |g|}}
              <tr class="{{#if g.far}}is-far{{/if}}">
                <td><span class="ij-dots">{{#each g.dots as |on|}}<i class="{{#if on}}on{{/if}}"></i>{{/each}}</span>{{g.label}}</td>
                <td>{{g.cost}}</td>
                <td>{{g.dc}}</td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>

        <div class="ij-ki__tree">
          <header class="ij-head">
            <span class="ij-head__kanji" aria-hidden="true">術</span>
            <h3>{{localize "IJ.Jutsu.known"}}</h3>
            <span class="ij-head__note">
              {{#if jutsuCount}}<strong>{{jutsuCount}}</strong>{{/if}}
              {{#if editable}}<a class="ij-plus" data-action="itemCreate" data-type="jutsu" data-tooltip="{{localize 'IJ.Jutsu.add'}}">+</a>{{/if}}
            </span>
          </header>

          {{#each veins as |v|}}
          <div class="ij-vein {{#unless v.open}}is-closed{{/unless}}">
            <div class="ij-vein__head">
              <span class="ij-vein__kanji" aria-hidden="true">{{v.kanji}}</span>
              <h3>{{v.label}}</h3>
              <small>{{v.note}}</small>
            </div>
            <ul class="ij-twigs">
              {{#each v.grades as |g|}}
              <li>
                <div class="ij-vein__grade"><b>{{g.label}}</b><small>{{g.cost}} {{localize "IJ.PM.abbr"}} · {{localize "IJ.Jutsu.dc"}} {{g.dc}}</small></div>
                <div class="ij-scrolls">
                  {{#each g.items as |j|}}
                  <span class="ij-scroll ij-item draggable {{#if j.picked}}is-picked{{/if}}" data-item-id="{{j.id}}">
                    <a class="ij-orb" data-action="itemUse" data-tooltip="{{localize 'IJ.Jutsu.executeTip'}}">{{j.cost}}</a>
                    <a class="ij-scroll__name" data-action="itemSelect" data-drawer="jutsus" data-tooltip="{{j.tip}}">{{j.name}}</a>
                  </span>
                  {{/each}}
                </div>
              </li>
              {{/each}}
            </ul>
          </div>
          {{else}}
          <p class="ij-none">{{localize "IJ.Jutsu.emptyHint"}}</p>
          {{/each}}

          {{#if jutsuCount}}<p class="ij-hint">{{localize "IJ.Jutsu.hint"}}</p>{{/if}}
        </div>
      </div>
    </div>

    <aside class="ij-drawer" data-drawer="jutsus">{{> ij-detail detail}}</aside>
  </div>
</section>
