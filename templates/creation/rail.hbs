{{!-- The character as it stands, beside every step: portrait, name, what was chosen (a click opens that step), the
     seven abilities, the numbers of play and the Measure of Honor, all from the preview actor. --}}
<aside class="wz-rail">
  <div class="wz-rail-card">
    <div class="wz-portrait"><img src="{{portrait}}" alt=""></div>
    <h3 class="wz-rail-name">{{name}}</h3>
    <span class="wz-rail-sub">{{subtitle}}</span>
  </div>
  <ul class="wz-rail-lines">
    {{#each lines}}
    <li class="{{#if name}}set{{/if}}">
      <a data-action="step" data-step="{{step}}">
        <span class="wz-rail-icon">{{#if img}}<img src="{{img}}" alt="">{{else}}<i class="{{icon}}"></i>{{/if}}</span>
        <span class="wz-rail-text"><small>{{label}}</small><b>{{#if name}}{{name}}{{else}}—{{/if}}</b>{{#if note}}<em>{{note}}</em>{{/if}}</span>
      </a>
    </li>
    {{/each}}
  </ul>
  <div class="wz-rail-abilities{{#unless ready}} faded{{/unless}}">
    {{#each abilities}}<div class="{{#if honor}}honor{{/if}}" data-tooltip-text="{{tip}}"><small>{{abbr}}</small><b>{{total}}</b><span>{{mod}}</span></div>{{/each}}
  </div>
  <div class="wz-rail-numbers{{#unless ready}} faded{{/unless}}">
    {{#each numbers}}<div><i class="{{icon}}"></i><b>{{value}}</b><small>{{label}}</small></div>{{/each}}
  </div>
  <div class="wz-rail-saves{{#unless ready}} faded{{/unless}}">
    {{#each saves}}<div><small>{{label}}</small><b>{{value}}</b></div>{{/each}}
  </div>
  <div class="wz-rail-honor tier-{{honor.key}}">
    <span>{{localize "IJ.Honor.measure"}}</span>
    <b>{{honor.tier}}</b>
    <em>{{honor.total}}</em>
  </div>
</aside>
