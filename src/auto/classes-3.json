  "Shugenja/Orientação": {
    "requires": { "honorMin": 16 },
    "status": "parcial", "notes": "Confira Int 3+ do alvo; na resolução, o fim do efeito é à mão.",
    "choice": {
      "label": "Efeitos de orientação", "count": "@rank",
      "options": [
        { "id": "aviso", "label": "Aviso" },
        { "id": "conselho", "label": "Conselho", "hint": "Exige aviso." },
        { "id": "coordenar", "label": "Coordenar", "hint": "Exige manobrar." },
        { "id": "criticaConstrutiva", "label": "Crítica construtiva", "hint": "Exige coordenar e 11º nível.", "minLevel": 11 },
        { "id": "criticaDestrutiva", "label": "Crítica destrutiva", "hint": "Exige crítica construtiva e 17º nível.", "minLevel": 17 },
        { "id": "expedicao", "label": "Expedição", "hint": "Exige 5º nível.", "minLevel": 5 },
        { "id": "manobrar", "label": "Manobrar" },
        { "id": "precisao", "label": "Precisão" },
        { "id": "resolucao", "label": "Resolução" }
      ]
    },
    "activation": {
      "cost": 1, "action": "padrão", "duration": { "unit": "cena" },
      "note": "Uma criatura a até 9m, com Int 3+ e Honra 10+, que o veja ou ouça.",
      "options": [
        { "id": "aviso", "label": "Aviso", "option": "aviso",
          "targets": { "who": "allies", "duration": { "unit": "cena" }, "changes": [{ "key": "system.attributes.mods.saves", "value": "lvl(1:1, 5:2, 11:3, 17:4)" }],
            "variants": [{ "when": "vsDishonored", "changes": [] }] } },
        { "id": "conselho", "label": "Conselho", "option": "conselho",
          "targets": { "who": "allies", "duration": { "unit": "cena" }, "changes": [{ "key": "system.attributes.mods.skills", "value": "lvl(1:2, 8:4, 14:6, 20:8)" }],
            "variants": [{ "when": "vsDishonored", "changes": [] }] } },
        { "id": "coordenar", "label": "Coordenar", "option": "coordenar",
          "targets": { "who": "allies", "duration": { "unit": "cena" }, "changes": [{ "key": "system.attributes.mods.attack", "value": "lvl(1:1, 8:2, 14:3, 20:4)" }],
            "variants": [{ "when": "vsDishonored", "changes": [] }] } },
        { "id": "criticaConstrutiva", "label": "Crítica construtiva", "option": "criticaConstrutiva", "minLevel": 11, "duration": { "value": 1, "unit": "rodada" },
          "targets": { "who": "allies", "duration": { "value": 1, "unit": "rodada" }, "changes": [{ "key": "system.attributes.critBonus", "value": 1 }],
            "variants": [{ "when": "vsDishonored", "changes": [] }] } },
        { "id": "criticaDestrutiva", "label": "Crítica destrutiva", "option": "criticaDestrutiva", "minLevel": 17, "duration": { "value": 1, "unit": "rodada" },
          "targets": { "who": "allies", "duration": { "value": 1, "unit": "rodada" }, "changes": [{ "key": "system.attributes.critMult", "value": 1 }],
            "variants": [{ "when": "vsDishonored", "changes": [] }] } },
        { "id": "expedicao", "label": "Expedição", "option": "expedicao", "minLevel": 5,
          "targets": { "who": "allies", "duration": { "unit": "cena" }, "changes": [{ "key": "system.attributes.movement.bonus", "value": "lvl(1:3, 11:6, 17:9)" }],
            "variants": [{ "when": "vsDishonored", "changes": [] }] } },
        { "id": "expedicaoVoce", "label": "Expedição em você", "option": "expedicao", "minLevel": 5,
          "self": { "changes": [{ "key": "system.attributes.movement.bonus", "value": "lvl(1:3, 11:6, 17:9)" }] } },
        { "id": "manobrar", "label": "Manobrar", "option": "manobrar",
          "targets": { "who": "allies", "duration": { "unit": "cena" },
            "rollOptions": [{ "id": "manobrar", "label": "Manobrar (orientação)", "for": "maneuver", "value": "lvl(1:2, 5:4, 11:6, 17:8)" }],
            "variants": [{ "when": "vsDishonored", "rollOptions": [] }] } },
        { "id": "precisao", "label": "Precisão", "option": "precisao", "duration": { "value": 1, "unit": "rodada" },
          "targets": { "who": "allies", "duration": { "value": 1, "unit": "rodada" },
            "rollOptions": [{ "id": "precisao", "label": "Precisão", "damage": "(1 + floor((@classe - 2) / 6))d6", "noCrit": true, "precision": true }],
            "variants": [{ "when": "vsDishonored", "rollOptions": [] }] } },
        { "id": "precisaoVoce", "label": "Precisão em você", "option": "precisao", "duration": { "value": 1, "unit": "rodada" },
          "self": { "rollOptions": [{ "id": "precisao", "label": "Precisão", "damage": "(1 + floor((@classe - 2) / 6))d6", "noCrit": true, "precision": true }] } },
        { "id": "resolucao", "label": "Resolução", "option": "resolucao", "duration": { "value": 1, "unit": "rodada" },
          "note": "Novo teste contra um efeito contínuo; passando, ele acaba e seu dano é desfeito.",
          "targets": { "who": "allies", "duration": { "value": 1, "unit": "rodada" }, "consumeOn": "save",
            "rollOptions": [{ "id": "resolucao", "label": "Resolução (+4 no novo teste)", "for": "save", "value": 4 }],
            "variants": [{ "when": "vsDishonored", "rollOptions": [], "consumeOn": null }] } },
        { "id": "resolucaoVoce", "label": "Resolução em você", "option": "resolucao", "duration": { "value": 1, "unit": "rodada" },
          "note": "Novo teste contra um efeito contínuo; passando, ele acaba e seu dano é desfeito.",
          "self": { "consumeOn": "save", "rollOptions": [{ "id": "resolucao", "label": "Resolução (+4 no novo teste)", "for": "save", "value": 4 }] } }
      ]
    }
  },
